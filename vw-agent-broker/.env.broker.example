# ============================================================================
#  Geheimnisse fuer den Broker-Container.
#  Nach ".env.broker" kopieren und ausfuellen. NICHT ins Git-Repository!
#
#  Diese Werte ueberschreiben die gleichnamigen Eintraege aus config.toml -
#  so bleibt die config.toml frei von Geheimnissen.
# ============================================================================

# Passwort fuer das Dashboard unter https://broker.DEINE-DOMAIN/admin
BROKER_ADMIN_PASS=

# HMAC-Schluessel fuer die Einmal-Links in den ntfy-Nachrichten.
#   openssl rand -hex 32
BROKER_SERVER_SECRET=

# Zugriffstoken fuer das geschuetzte ntfy-Topic (beginnt mit tk_).
#   docker compose exec ntfy ntfy token add agent-broker
BROKER_NTFY_TOKEN=

# HINWEIS: Das Master-Passwort des agent-Kontos gehoert BEWUSST NICHT hierher.
# Der bw-Sidecar startet gesperrt; entsperrt wird einmalig im Dashboard unter
# /admin. Siehe BROKER.md, Abschnitt "Warum kein Passwort in der .env".
