# ============================================================================
#  Vaultwarden - Konfiguration
#  Diese Datei nach ".env" kopieren und anpassen (macht ./setup.sh automatisch).
#  Die .env enthaelt Geheimnisse und gehoert NICHT in ein Git-Repository.
#
#  Wichtig zur Syntax: Das ist KEIN Shell-Skript. Kein "export", keine
#  Leerzeichen um das "=". Werte, die Sonderzeichen wie $ enthalten (z.B. der
#  Argon2-Hash des ADMIN_TOKEN), gehoeren in EINFACHE Anfuehrungszeichen -
#  darin ersetzt Docker Compose keine Variablen.
# ============================================================================

# ----------------------------------------------------------------------------
# Domain und Zertifikate
# ----------------------------------------------------------------------------

# Nackter Hostname - wird von Caddy als Site-Adresse benutzt.
# Voraussetzung: Ein DNS-A-Record (und ggf. AAAA) zeigt auf die IP des VPS.
DOMAIN=vault.example.de

# E-Mail fuer Let's Encrypt (Ablauf-Benachrichtigungen).
ACME_EMAIL=admin@example.de

# Dieselbe Domain, aber als vollstaendige URL - das braucht Vaultwarden intern
# fuer Links in E-Mails, WebAuthn/Passkeys, U2F und die Push-Registrierung.
# Muss zu DOMAIN passen und immer mit https:// beginnen.
VAULTWARDEN_DOMAIN=https://vault.example.de

# ----------------------------------------------------------------------------
# Registrierung
# ----------------------------------------------------------------------------

# Solange true, kann sich JEDER, der die URL kennt, ein Konto anlegen.
# ==> Direkt nach der eigenen Registrierung auf false setzen und
#     "docker compose up -d" erneut ausfuehren!
SIGNUPS_ALLOWED=true

# Falls spaeter doch weitere Personen (Familie) dazukommen sollen, ohne die
# Registrierung global zu oeffnen: Einladungen ueber das Admin-Panel verschicken
# (funktioniert auch ohne SMTP, dann per manuell kopiertem Link).
INVITATIONS_ALLOWED=true

# Nur Konten mit diesen Mail-Domains duerfen sich registrieren (optional).
# SIGNUPS_DOMAINS_WHITELIST=example.de
# SIGNUPS_VERIFY=true

# ----------------------------------------------------------------------------
# Admin-Panel   ->   https://DEINE-DOMAIN/admin
# ----------------------------------------------------------------------------

# Ohne ADMIN_TOKEN ist das Admin-Panel komplett deaktiviert.
# Empfohlen ist ein Argon2-PHC-Hash (beginnt mit $argon2id$...), damit im
# Klartext nichts Verwertbares auf der Platte liegt.
#
# Erzeugen laesst ihn ./setup.sh automatisch, manuell geht es so:
#   docker run --rm -it vaultwarden/server /vaultwarden hash --preset owasp
#
# Der Hash enthaelt $-Zeichen. Deshalb ZWINGEND in einfache Anfuehrungszeichen
# setzen, sonst versucht Docker Compose Teile davon als Variablen zu ersetzen
# und der Token passt nicht mehr:
#   ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$...'
ADMIN_TOKEN=

# ----------------------------------------------------------------------------
# Logging (Grundlage fuer fail2ban)
# ----------------------------------------------------------------------------

LOG_FILE=/data/vaultwarden.log
LOG_LEVEL=warn
# Client-IP kommt vom Reverse Proxy; Caddy setzt diesen Header (siehe Caddyfile).
IP_HEADER=X-Real-IP
# Zeitstempel im Log (fail2ban wertet ihn aus)
EXTENDED_LOGGING=true

# ----------------------------------------------------------------------------
# Feintuning / Sicherheit
# ----------------------------------------------------------------------------

# Web-Vault (Weboberflaeche) aktiv lassen - wird fuer den Dashlane-Import gebraucht.
WEB_VAULT_ENABLED=true

# Icons der Webseiten nachladen. false = etwas mehr Privatsphaere, dafuer
# graue Platzhalter in den Clients.
# DISABLE_ICON_DOWNLOAD=false

# Passwort-Hinweise nie direkt anzeigen (nur per Mail, wenn SMTP eingerichtet ist).
SHOW_PASSWORD_HINT=false

# Anzahl erlaubter Fehlversuche, bevor Vaultwarden die Anmeldung ausbremst.
# LOGIN_RATELIMIT_MAX_BURST=10
# LOGIN_RATELIMIT_SECONDS=60

# Zeitzone des Containers (fuer Logs und Backup-Zeitstempel)
TZ=Europe/Berlin

# WICHTIG zu WebSockets: Aktuelle Vaultwarden-Versionen liefern die Live-Sync
# ueber denselben Port 80 aus. Die frueher noetigen Variablen WEBSOCKET_ENABLED
# und WEBSOCKET_PORT (3012) sowie ein zweiter Proxy-Eintrag entfallen komplett.

# ----------------------------------------------------------------------------
# Optional: E-Mail-Versand (SMTP)
# ----------------------------------------------------------------------------
# Ohne SMTP funktioniert alles Wesentliche, aber es gibt keine Einladungs-Mails,
# keine "Neues Geraet"-Warnungen und kein E-Mail-basiertes 2FA.
#
# SMTP_HOST=smtp.example.de
# SMTP_FROM=vault@example.de
# SMTP_FROM_NAME=Vaultwarden
# SMTP_USERNAME=vault@example.de
# SMTP_PASSWORD='hier-das-smtp-passwort'
# SMTP_PORT=587
# SMTP_SECURITY=starttls          # starttls (587) | force_tls (465) | off (25)
# SMTP_TIMEOUT=15

# ----------------------------------------------------------------------------
# Optional: Push-Benachrichtigungen fuer Mobilgeraete (Android/iOS)
# ----------------------------------------------------------------------------
# Ohne Push synchronisiert die Android-App nur beim Oeffnen bzw. periodisch.
# Mit Push kommen Aenderungen sofort an - so wie man es von Dashlane kennt.
#
# Vorgehen: Auf https://bitwarden.com/host eine kostenlose Installations-ID und
# einen Key fuer die eigene Instanz anfordern (E-Mail eintragen, Daten kommen
# direkt auf der Seite bzw. per Mail). Danach hier eintragen und neu starten.
# Die eigentlichen Vault-Daten bleiben dabei Ende-zu-Ende-verschluesselt auf dem
# eigenen Server - ueber Bitwardens Relay geht nur das "es gibt etwas Neues".
#
# PUSH_ENABLED=true
# PUSH_INSTALLATION_ID=00000000-0000-0000-0000-000000000000
# PUSH_INSTALLATION_KEY=hier-der-key
# Fuer Konten in der EU-Cloud-Region stattdessen die EU-Endpunkte verwenden:
# PUSH_RELAY_URI=https://push.bitwarden.eu
# PUSH_IDENTITY_URI=https://identity.bitwarden.eu

# ----------------------------------------------------------------------------
# Optional: YubiKey / Duo / weitere 2FA-Anbieter
# ----------------------------------------------------------------------------
# TOTP-Apps und WebAuthn/Passkeys funktionieren ohne zusaetzliche Konfiguration.
# YUBICO_CLIENT_ID=
# YUBICO_SECRET_KEY=
